<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageVersion>1.0.0-alpha.1</PackageVersion>
    <Description>Zero-overhead runtime for compilers generated by Symphony: source text, tokens, diagnostics and a table-driven LR parser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkestra.Tests" />
  </ItemGroup>

</Project>
